---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AgregarDetalle from "../../components/AgregarDetalle.jsx";
import { fetchGraphQL } from "../../services/api";
import "../../templates/DetalleProducto.css";

interface Producto {
  id: number | string;
  nombre: string;
  precio: number | string;
  imagen: string;
  disponible: boolean;
  categoria: {
    id: number | string;
    nombre: string;
  };
}

export async function getStaticPaths() {
  const data = (await fetchGraphQL(`
    query {
      productos(limite: 100) {
        id
        nombre
        precio
        imagen
        disponible
        categoria {
          id
          nombre
        }
      }
    }
  `)) as { productos: Producto[] };

  return data.productos.map((producto) => ({
    params: { id: String(producto.id) },
    props: { producto },
  }));
}

const { producto } = Astro.props as { producto: Producto };
const precio = Number(producto.precio);
---

<BaseLayout titulo={`${producto.nombre} | Café del L`}>
  <section class="detalle-producto">
    <a class="detalle-producto-back" href={`/categorias/${producto.categoria.id}`}>
      ← {producto.categoria.nombre}
    </a>

    <article class="producto-detail">
      <div class="producto-image-wrap">
        <img src={producto.imagen} alt={producto.nombre} />
      </div>

      <div class="producto-info">
        <h2>{producto.nombre}</h2>
        <p class="producto-category">Categoría: {producto.categoria.nombre}</p>
        <p class="producto-price">{Number.isFinite(precio) ? `$${precio.toFixed(2)}` : "Precio no disponible"}</p>

        {producto.disponible ? (
          <AgregarDetalle client:load producto={producto} />
        ) : (
          <p class="producto-agotado">Agotado por ahora</p>
        )}
      </div>
    </article>
  </section>
</BaseLayout>