---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AgregarDetalle from "../../components/AgregarDetalle.jsx";
import { fetchGraphQL } from "../../services/api";
import "../../templates/DetalleProducto.css";
import { Image } from 'astro:assets';

interface Producto {
  id: number | string;
  nombre: string;
  precio: number | string;
  imagen: string;
  disponible: boolean;
  categoria: {
    id: number | string;
    nombre: string;
  };
}

export async function getStaticPaths() {
  const data = (await fetchGraphQL(`
    query {
      productos(limite: 100) {
        id
        nombre
        precio
        imagen
        disponible
        categoria {
          id
          nombre
        }
      }
    }
  `)) as { productos: Producto[] };

  return data.productos.map((producto) => ({
    params: { id: String(producto.id) },
    props: { producto },
  }));
}

const { producto } = Astro.props as { producto: Producto };
const precio = Number(producto.precio);
const precioFormateado = new Intl.NumberFormat("es-MX", {
  style: "currency",
  currency: "MXN",
}).format(precio);
const siteUrl = Astro.site ?? new URL("https://la-del-l.netlify.app");
const productoUrl = new URL(`/products/${producto.id}/`, siteUrl).toString();
const productJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  name: producto.nombre,
  ...(producto.imagen && { image: new URL(producto.imagen, siteUrl).toString() }),
  category: producto.categoria.nombre,
  url: productoUrl,
  ...(Number.isFinite(precio) &&
    precio >= 0 && {
      offers: {
        "@type": "Offer",
        url: productoUrl,
        priceCurrency: "MXN",
        price: precio,
        availability: `https://schema.org/${producto.disponible ? "InStock" : "OutOfStock"}`,
        itemCondition: "https://schema.org/NewCondition",
        seller: {
          "@type": "Organization",
          name: "Café del L",
        },
      },
    }),
}).replace(/</g, "\\u003c");
---

<BaseLayout titulo={`${producto.nombre} | Café del L`}>
  <script type="application/ld+json" set:html={productJsonLd} />
  <section class="detalle-producto">
    <div class="detalle-producto-inner">
      <a class="detalle-producto-back" href={`/categorias/${producto.categoria.id}`}>← Volver</a>

      <article class="detalle-producto-card">
        <figure class="detalle-producto-media">
          <Image src={producto.imagen} alt={producto.nombre} loading="eager" fetchpriority="high" width={500} height={500} style="width: 100%; aspect-ratio: 1 / 1; object-fit: cover;" />
        </figure>

        <div class="detalle-producto-info">
          <p class="detalle-producto-kicker">{producto.categoria.nombre}</p>
          <h2>{producto.nombre}</h2>
          <p class="detalle-producto-precio">
            {Number.isFinite(precio) ? precioFormateado : "Precio no disponible"}
          </p>

          {producto.disponible ? (
            <AgregarDetalle client:idle producto={producto} />
          ) : (
            <p class="detalle-producto-agotado">Agotado por ahora</p>
          )}
        </div>
      </article>
    </div>
  </section>
</BaseLayout>