---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SideBar from "../../components/SideBar.astro";
import Main from "../../components/Main.astro";
import { fetchGraphQL } from "../../services/api";

export async function getStaticPaths() {
  const data = (await fetchGraphQL(`
    query {
      categorias {
        id
        nombre
      }
    }
  `)) as { categorias: { id: string | number; nombre: string }[] };

  return data.categorias.map((categoria) => ({
    params: { id: String(categoria.id) },
    props: { categoria },
  }));
}

const { categoria } = Astro.props as {
  categoria: { id: string | number; nombre: string };
};

const data = (await fetchGraphQL(`
  query {
    productos(limite: 100) {
      id
      nombre
      precio
      categoria {
        id
      }
      imagen
      disponible
    }
  }
`)) as {
  productos: {
    id: string | number;
    nombre: string;
    precio: string | number;
    imagen: string;
    disponible: boolean;
    categoria: { id: string | number };
  }[];
};

const productos = data.productos.filter(
  (producto) => producto.categoria?.id === categoria.id
);
---

<BaseLayout titulo={`${categoria.nombre} | Café del L`}>
  <div class="inicio-contenido">
    <SideBar />
    <div>
      <header class="categoria-heading">
        <a class="categoria-back" href="/">← Volver</a>
        <h2>{categoria.nombre}</h2>
      </header>
      <Main productos={productos} />
    </div>
  </div>
</BaseLayout>