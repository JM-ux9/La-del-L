---
import { fetchGraphQL } from "../services/api";
import "./SideBar.css";

const data = (await fetchGraphQL(`
  query {
    categorias {
      id
      nombre
    }
  }
`)) as { categorias: { id: string | number; nombre: string }[] };

const actual = Astro.url.pathname.replace(/\/+$/, "");
---

<aside class="sidebar">
  <h2 class="sidebar-title">Categorías</h2>
  <ul>
    {data.categorias.map((categoria) => {
      const href = `/categorias/${categoria.id}`;
      const activa = actual === href;
      return (
        <li>
          <a
            href={href}
            class={activa ? "is-active" : undefined}
            aria-current={activa ? "page" : undefined}
          >
            {categoria.nombre}
          </a>
        </li>
      );
    })}
  </ul>
</aside>