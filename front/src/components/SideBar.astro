  ---
import { fetchGraphQL } from "../services/api";
import "./SideBar.css";

const data = (await fetchGraphQL(`
  query {
    categorias {
      id
      nombre
    }
  }
`)) as { categorias: { id: string | number; nombre: string }[] };

const rutaActual = Astro.url.pathname.replace(/\/$/, "");
---

<aside class="sidebar">
  <ul>
    {data.categorias.map((categoria) => (
      <li>
        <a
          href={`/categorias/${categoria.id}`}
          aria-current={rutaActual === `/categorias/${categoria.id}` ? "page" : undefined}
        >
          {categoria.nombre}
        </a>
      </li>
    ))}
  </ul>
</aside>