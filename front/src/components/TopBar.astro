---
import ContadorCarrito from "./ContadorCarrito.jsx";
import BotonCerrarSesion from "./BotonCerrarSesion.jsx";
import BotonDashboard from "./BotonDashboard.jsx";
import "./TopBar.css";
---

<header class="topbar">
  <div class="topbar-left">
    <h1>
      <a class="topbar-titulo" href="/">Café del </a><span class="aurora-text2"
        >L</span
      >
    </h1>
    <ContadorCarrito client:load />
    <a href="/mis-pedidos" class="topbar-pedidos">Mis pedidos</a>
  </div>
  <div class="topbar-right">
    <div class="topbar-busqueda">
      <input type="text" placeholder="Buscar productos..." id="busqueda" />
    </div>
    <BotonDashboard client:load />
    <BotonCerrarSesion client:load />
    <a href="/">
      <img
        src="https://cdn-icons-png.flaticon.com/512/8230/8230211.png"
        width="40"
        height="40"
        alt="Logo"
        class="topbar-logo"
      />
    </a>
  </div>
</header>
